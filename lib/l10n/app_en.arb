  "profile_support_hours_title": "Support Hours",
  "profile_support_hours_content": "We're available to assist you 24/7",
  "profile_copied_clipboard": "{label} copied to clipboard",
  "profile_privacy_policy_title": "Privacy Policy",
  "profile_last_updated": "Last updated: {date}",
  "profile_info_collect_title": "Information We Collect",
  "profile_info_collect_content": "We collect information that you provide directly to us when you create an account, make a booking, or contact us. This may include your name, email address, phone number, and booking preferences.",
  "profile_how_use_info_title": "How We Use Your Information",
  "profile_how_use_info_content": "We use your information to:\n• Process and manage your bookings\n• Communicate with you about your reservations\n• Improve our services and user experience\n• Send important updates and notifications\n• Ensure security and prevent fraud",
  "profile_data_protection_title": "Data Protection",
  "profile_data_protection_content": "We implement robust security measures to protect your personal information. Your data is encrypted and stored securely. We never sell or share your personal information with third parties for marketing purposes.",
  "profile_your_rights_title": "Your Rights",
  "profile_your_rights_content": "You have the right to:\n• Access your personal data\n• Request corrections to your information\n• Delete your account and associated data\n• Opt-out of promotional communications\n• Request a copy of your data",
  "profile_cookies_tracking_title": "Cookies and Tracking",
  "profile_cookies_tracking_content": "We use cookies and similar technologies to enhance your experience, analyze usage patterns, and remember your preferences. You can control cookie settings through your browser.",
  "profile_third_party_title": "Third-Party Services",
  "profile_third_party_content": "We may use third-party services for payment processing, analytics, and communication. These services have their own privacy policies and we encourage you to review them.",
  "profile_children_privacy_title": "Children's Privacy",
  "profile_children_privacy_content": "Our services are not intended for users under the age of 18. We do not knowingly collect personal information from children.",
  "profile_policy_changes_title": "Changes to This Policy",
  "profile_policy_changes_content": "We may update this privacy policy from time to time. We will notify you of any significant changes by posting the new policy on this page and updating the \"Last updated\" date.",
  "profile_privacy_agree_info": "By using our services, you agree to this Privacy Policy.",
  "profile_refund_cancel_title": "Refund & Cancellation",
  "profile_cancel_rules_title": "Cancellation Rules",
  "profile_cancel_rules_content": "You can cancel your booking through the app. Cancellation policies vary by property and are clearly stated at the time of booking. Please review the specific cancellation terms before confirming your reservation.",
  "profile_flexible_cancel_title": "Flexible Cancellation",
  "profile_flexible_cancel_content": "• Cancel up to 48 hours before check-in: 100% refund\n• Cancel 24-48 hours before check-in: 50% refund\n• Cancel less than 24 hours before check-in: No refund\n• No-show: No refund",
  "profile_strict_cancel_title": "Strict Cancellation",
  "profile_strict_cancel_content": "• Cancel up to 7 days before check-in: 50% refund\n• Cancel less than 7 days before check-in: No refund\n• No-show: No refund",
  "profile_non_refundable_title": "Non-Refundable",
  "profile_non_refundable_content": "Some special offers and promotions are non-refundable. These bookings are clearly marked during the booking process. Once confirmed, these reservations cannot be cancelled or refunded.",
  "profile_refund_proc_title": "Refund Processing",
  "profile_refund_proc_content": "• Approved refunds are processed within 5-10 business days\n• Refunds are returned to the original payment method\n• You will receive a confirmation email once the refund is processed\n• Bank processing may take additional 3-5 business days",
  "profile_special_circ_title": "Special Circumstances",
  "profile_special_circ_content": "In case of emergencies or unforeseen circumstances (natural disasters, medical emergencies, etc.), please contact us directly. We will review your case and work with the property owner to find a fair solution.",
  "profile_booking_mod_title": "Booking Modifications",
  "profile_booking_mod_content": "You can request to modify your booking dates subject to availability and property approval. Modifications may incur additional charges based on price differences and modification policies.",
  "profile_dispute_res_title": "Dispute Resolution",
  "profile_dispute_res_content": "If you have any issues with your booking or refund, please contact us immediately. We are committed to resolving all disputes fairly and promptly. Our support team will mediate between you and the property owner.",
  "profile_review_specific_policy": "Always review the specific cancellation policy for your chosen property before booking. Policies may vary.",
  "profile_questions_cancel": "Questions about cancellations?",
  "profile_booking_confirm_title": "Booking & Confirmation",
  "profile_instant_confirm_title": "Instant Confirmation",
  "profile_instant_confirm_content": "Once your booking is submitted and payment is processed, you will receive an instant confirmation via email and in-app notification. Your booking details will be immediately available in your account.",
  "profile_booking_timeline_title": "Booking Timeline",
  "profile_booking_timeline_content": "You can book a chalet up to 6 months in advance. Last-minute bookings are accepted subject to availability. We recommend booking at least 48 hours before your desired check-in date for the best availability.",
  "profile_checkin_proc_title": "Check-In Process",
  "profile_checkin_proc_content": "• Check-in time: As specified in the chalet listing (typically 2:00 PM)\n• You will receive check-in instructions 24 hours before arrival\n• Present your booking confirmation to the property owner\n• All guest information must be accurate and verified",
  "profile_checkout_proc_title": "Check-Out Process",
  "profile_checkout_proc_content": "• Check-out time: As specified in the chalet listing (typically 12:00 PM)\n• Please leave the chalet in good condition\n• Return all keys and access cards\n• Late check-out may be available upon request (additional fees may apply)",
  "profile_booking_verify_title": "Booking Verification",
  "profile_booking_verify_content": "All bookings are subject to verification by the property owner. In rare cases, a booking may be declined. If this occurs, you will receive a full refund within 3-5 business days.",
  "profile_important_info_title": "Important Information",
  "profile_important_info_content": "• Bring a valid ID for check-in\n• Review house rules before your stay\n• Maximum occupancy must be respected\n• Smoking and pet policies vary by property\n• Contact the owner for any special requests",
  "profile_stay_support_title": "Support During Your Stay",
  "profile_stay_support_content": "Our support team is available 24/7 to assist you during your stay. Contact us immediately if you encounter any issues with the property or have questions about your booking.",
